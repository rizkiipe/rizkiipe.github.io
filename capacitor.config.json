{
  "appId": "com.utrack.app",
  "appName": "U-Track",
  "webDir": "www",
  "backgroundColor": "#0A0E17",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0A0E17",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0A0E17"
    },
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "DARK"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_utrack",
      "iconColor": "#33D8C9"
    }
  }
}
